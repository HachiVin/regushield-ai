# Copy to .env (git-ignored). On Streamlit Cloud put the same keys in Settings > Secrets.
GROQ_API_KEY=gsk_REPLACE_ME

# Optional overrides (defaults shown)
# REGUSHIELD_LLM_MODEL=openai/gpt-oss-20b
# REGUSHIELD_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# REGUSHIELD_RERANKER_MODEL=ms-marco-MultiBERT-L-12
# REGUSHIELD_RERANK_CANDIDATES=12
# REGUSHIELD_MIN_TERM_COVERAGE=0.10
# REGUSHIELD_MIN_SIMILARITY=0.60
# REGUSHIELD_TOP_K=5
# REGUSHIELD_CHUNK_SIZE=500
# REGUSHIELD_CONTEXT_WINDOW=1
# REGUSHIELD_FUSE_RERANK=false   # true = RRF of BM25, vector and reranker ranks
# REGUSHIELD_OCR=true            # false = do not read text inside images
# REGUSHIELD_DATA_DIR=data
# REGUSHIELD_API_KEY=            # set to require an X-API-Key header on the REST API
# REGUSHIELD_LOG_QUESTIONS=true  # false = keep question text out of the query log